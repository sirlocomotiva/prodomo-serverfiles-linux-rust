# Prodomo server configuration (TOML).
#
# One process runs auth and every Channel (docs/adr/0002-one-process-for-every-channel.md). This
# file replaces the legacy per-Core `CONFIG` files and the DB server's `conf.txt`; see
# docs/REWRITE_LEDGER.md sections 169 and 178 for how each legacy key maps here.
#
# The topology and values below are the owner's legacy deployment (legacy/config), translated.
# An UNKNOWN key is an error, so a typo fails at startup. Booleans must be real TOML booleans
# (`true` / `false`), not the legacy `1` / `0`.
#
# Start with:  prodomo --config prodomo.toml serve

# Address every listener binds.
bind_ip = "0.0.0.0"

# IPv4 address the client is told to reconnect to on a Warp and in the character list. Set it to
# the address players reach this machine on. Legacy sent `proxy_ip` when set and `bind_ip`
# otherwise.
public_ip = "127.0.0.1"

[store]
# PostgreSQL 18. The password in this URL is never logged. No connection is opened until the
# first query.
url = "postgres://prodomo:CHANGE-ME@127.0.0.1:5432/prodomo"
max_connections = 8

[auth]
port = 30001

# One table per Channel. `ports` keeps every legacy Core port of the Channel so that a client
# server list naming any of them still works; all of them lead into the same world. `maps` is the
# union of the Channel's legacy `MAP_ALLOW` lists. Channel 99 is the Shared Channel: players reach
# it only by Warp, and none of its maps may appear in another Channel.
#
# Channel 1 hosts eight maps Channels 2-4 do not (56, 209, 358, 359, 373, 374, 376, 377), as the
# legacy deployment did.

[[channel]]
number = 1
ports = [30003, 30005]
maps = [
    1, 3, 4, 5, 12, 13, 21, 23, 24, 25, 27, 34, 41, 43, 44, 45, 56, 61, 62, 63, 64, 65, 66, 67, 68,
    69, 70, 71, 75, 76, 104, 108, 109, 112, 134, 135, 136, 137, 138, 139, 193, 206, 209, 210, 212,
    216, 217, 226, 227, 235, 240, 358, 359, 373, 374, 376, 377,
]

[[channel]]
number = 2
ports = [30007, 30009]
maps = [
    1, 3, 4, 5, 12, 13, 21, 23, 24, 25, 27, 34, 41, 43, 44, 45, 61, 62, 63, 64, 65, 66, 67, 68, 69,
    70, 71, 75, 76, 104, 108, 109, 112, 134, 135, 136, 137, 138, 139, 193, 206, 210, 212, 216, 217,
    226, 227, 235, 240,
]

[[channel]]
number = 3
ports = [30011, 30013]
maps = [
    1, 3, 4, 5, 12, 13, 21, 23, 24, 25, 27, 34, 41, 43, 44, 45, 61, 62, 63, 64, 65, 66, 67, 68, 69,
    70, 71, 75, 76, 104, 108, 109, 112, 134, 135, 136, 137, 138, 139, 193, 206, 210, 212, 216, 217,
    226, 227, 235, 240,
]

[[channel]]
number = 4
ports = [30015, 30017]
maps = [
    1, 3, 4, 5, 12, 13, 21, 23, 24, 25, 27, 34, 41, 43, 44, 45, 61, 62, 63, 64, 65, 66, 67, 68, 69,
    70, 71, 75, 76, 104, 108, 109, 112, 134, 135, 136, 137, 138, 139, 193, 206, 210, 212, 216, 217,
    226, 227, 235, 240,
]

[[channel]]
number = 99
ports = [30019]
maps = [
    72, 73, 81, 103, 105, 110, 111, 113, 118, 119, 120, 121, 122, 123, 124, 125, 126, 127, 128, 133,
    181, 182, 183, 190, 191, 192, 207, 353, 354,
]

[game]
# Gameplay settings shared by every Channel. Omitted keys keep the legacy compiled-in default.
# The values set here are the ones the owner's legacy CONFIG files set, identical on every Core.
view_range = 10000
# In seconds. Legacy multiplied these by PASSES_PER_SEC while parsing; the Pulse rate is fixed at
# 25 per second (ADR-0002), so PASSES_PER_SEC is gone.
save_event_second_cycle = 180
ping_event_second_cycle = 180
max_level = 120
# CHANGE_ATTR_TIME_LIMIT: 0
item_bonus_change_time = 0
# EMOTION_MASK_REQUIRE: 0
disable_emotion_mask = true
# PRISM_ITEM_REQUIRE: 0
disable_prism_need = true
# SHOP_PRICE_3X_TAX: 0
disable_shop_price_3x = true
# GLOBAL_SHOUT: 1
enable_global_shout = true
item_count_limit = 2000
status_point_get_level_limit = 120
status_point_set_max_value = 90
shout_limit_level = 15
db_log_level = 1
# EMPIRE_LANGUAGE_CHECK: 0
disable_empire_language_check = true
vrajeste_permanent = false
intarire_permanent = false
mantie_permanent = true
# The legacy CONFIG files never set TEST_SERVER, and legacy defaults it to on (config.cpp:72), so
# the legacy deployment ran in test-server mode. It is written out here so the choice is visible.
test_server = true
# Empty disables the admin page. Legacy defaulted to a well-known password.
adminpage_ips = []
adminpage_password = ""
