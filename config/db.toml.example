# Metin2 database server configuration (TOML).
#
# The legacy `conf.txt` used `key=value` lines and is no longer read. See
# `docs/REWRITE_LEDGER.md` section 169 for the legacy-key to TOML-key mapping.
#
# Every key below is optional; an omitted key keeps the value shown, which is the
# compiled-in default. An UNKNOWN key is an error, so a typo fails at startup.
#
# SECURITY: the legacy listener defaulted BIND_IP to "0" and BIND_PORT to 5300 and
# treated an accepted socket as trusted. The defaults below are unchanged for wire
# compatibility, but nothing here authenticates a peer. Bind to a private interface
# and require an authenticated, role-bound peer before exposing this port. See
# AGENTS.md, "Security and trust boundaries".

# --- Peer listener ---------------------------------------------------------
bind_ip = "0.0.0.0"
bind_port = 5300

# --- Service ---------------------------------------------------------------
test_server = false
log = true
client_heart_fps = 50
log_keep_days = 3
locale = "latin1"
table_postfix = ""
name_column = "name"
player_id_start = 0

# --- Cache flush intervals (seconds) ---------------------------------------
player_cache_flush_seconds = 420
item_cache_flush_seconds = 300
item_pricelist_cache_flush_seconds = 540
cache_flush_limit_per_second = 0

# --- Trusted peers ---------------------------------------------------------
# Source addresses allowed to connect. This is TRANSPORT IDENTITY, NOT
# AUTHENTICATION: anything that can spoof the source address is admitted, and
# the legacy protocol has no credential exchange to replace this with.
#
# BOTH LISTS ARE EMPTY BY DEFAULT, WHICH REFUSES EVERY CONNECTION. With no entry
# here, every peer is denied every request, including the read-only boot
# request, and is closed without a reply. A server that serves nobody is safe
# but useless, so set at least one game address to accept a connection.
#
# A bare address is matched on IP only; a "host:port" entry keeps just the host,
# because the source port is chosen by the operating system. The same address
# may not appear in both lists, and an unparseable entry fails startup.
#
# Assigning a role here does NOT bind the auth slot, does not prove the peer is
# the process it claims to be, and does not bind an account or player. Only an
# explicit base-only setup effect can bind the auth slot. See
# `db-server::peer_auth` and `db-server::peer_policy`.
trusted_game_peers = []
trusted_auth_peers = []

# --- SQL connections -------------------------------------------------------
# The legacy value order here was: "<host> <database> <user> <password> <port>",
# which differs from the game server's order. Both are now explicit key/value pairs.

[sql_player]
host = "127.0.0.1"
port = 3306
user = "metin2"
password = "CHANGE-ME"
database = "player"

[sql_account]
host = "127.0.0.1"
port = 3306
user = "metin2"
password = "CHANGE-ME"
database = "account"

[sql_common]
host = "127.0.0.1"
port = 3306
user = "metin2"
password = "CHANGE-ME"
database = "common"
