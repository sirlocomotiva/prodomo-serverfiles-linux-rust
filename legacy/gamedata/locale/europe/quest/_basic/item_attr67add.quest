--[[
 Title: Add 6th and 7th Bonus
 Description: Allows your character to add an extra bonus (6th and 7th) to an item.
 Author: Owsap
 Last Date: 2021.08.13 (YMD)
]]

quest item_attr67add begin
	state start begin
		when login with pc.get_level() >= 30 begin
			send_letter("Sixth and Seventh Bonus")
		end

		when button or info begin
			say("It is possible to add a 6th or 7th bonus to an[ENTER]equipment item which already has 5 bonuses.[ENTER]Seon-Hae is the expert in these matters. Go and[ENTER]talk to him if you are interested.")
			set_state(talk)
		end
	end

	state talk begin
		function wait_time_to_str(timestamp)
			local left_secs = timestamp - get_global_time()
			if left_secs > 0 then
				hours = string.format("%02.f", math.floor(left_secs / 3600))
				mins = string.format("%02.f", math.floor(left_secs / 60 - (hours * 60)))
				secs = string.format("%02.f", math.floor(left_secs - hours * 3600 - mins * 60))
				if tonumber(hours) > 0 then
					return string.format("%d hrs. %d min.", hours, mins)
				else
					return string.format("%d minute(s) and %d second(s)", mins, secs)
				end
			end
		end

		when 20095.chat."Add 6th and 7th Bonus" begin
			if attr67add.holding() then
				if pc.getf("attr67add_item", "wait_time") > get_global_time() then
					say_title("Seon-Hae")
					say("It can take time to add an additional bonus.[ENTER]Please be patient.")
					say("[INSERT_ITEM_TOOLTIP_BY_CELL window_type;" .. attr67add.window_type() .. "|cell;" .. attr67add.window_cell() .. "]")
					say_reward(string.format("Remaining time: %s", item_attr67add.wait_time_to_str(pc.getf("attr67add_item", "wait_time"))))
					say("You can use a Time Spiral to accelerate the[ENTER]process.")
					say(color(255, 0, 0) .. "You can use a Time Spiral to accelerate the[ENTER]process." .. color(196, 196, 196))

					if pc.is_gm() then
						say("GM - Should the time be set to zero?")
						local s = select("Yes", "No")
						if s == 1 then
							pc.setf("attr67add_item", "wait_time", 0)
						end
					end
				else
					say_title("Seon-Hae")
					say_reward("Result")
					if attr67add.success() then
						say("Bonus added successfully!")
					else
						say("Failed to add additional bonus.")
					end
					say("[INSERT_ITEM_TOOLTIP_BY_CELL window_type;" .. attr67add.window_type() .. "|cell;" .. attr67add.window_cell() .. "]")
					if select("OK") == 1 then
						if pc.enough_inventory(attr67add.item_vnum()) then
							attr67add.collect()
						else
							say("There isn't enough space in your inventory.")
						end
					else return end
				end
			else
				setskin(NOWINDOW)
				cmdchat("__OpenAttr67AddDlg")
			end
		end

		when 72347.use or 72348.use or 72349.use or 72350.use begin
			if pc.getf("attr67add_item", "wait_time") > get_global_time() then
				local wait_time = pc.getf("attr67add_item", "wait_time") - get_global_time()
				local with_pct = wait_time * (item.get_value(3) / 100)
				local res_time = math.floor(math.abs(wait_time - with_pct))
				pc.setf("attr67add_item", "wait_time", get_global_time() + res_time)
				pc.remove_item(item.get_vnum(), 1)
			end
		end
	end
end
