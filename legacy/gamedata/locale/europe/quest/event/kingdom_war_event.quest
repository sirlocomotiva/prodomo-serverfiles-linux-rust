quest kingdom_war_event begin
	state start begin
		when login or event_begin with game.get_event_flag("kingdom_war_event") > 0 begin
			send_letter(translate.kingdom_war_event._010_npcChat)
		end
		
		when event_end with game.get_event_flag("kingdom_war_event") == 0 begin
			clear_letter()
		end
		
		when button or info begin
			say_title(translate.kingdom_war_event._010_npcChat)
			say()
			say()
			say(translate.kingdom_war_event._110_say)
			say()
			say(translate.kingdom_war_event._120_sayReward)
			
			if select(translate.locale.yes, translate.locale.no) == 2 then
				say()
				say(translate.kingdom_war_event._130_say)
				say()
			else
				if pc.get_map_index() == 103 then syschat(translate.kingdom_war_event._140_sysChat) return end
				
				pc.warp(0, 25600)
			end
		end
	end
end