local bIsMetin = npc . is_metin ( ) 
local bIsBoss = npc . is_boss ( ) 
local bIsMonster = not npc . is_pc ( ) 
local bIsPlayer = npc . is_pc ( ) 
local IsInDungeon = pc . in_dungeon ( ) 
if bIsMetin then 
pc . global_rank_add_point ( 0 , 1 ) 
elseif bIsBoss then 
if IsInDungeon then 
pc . global_rank_add_point ( 4 , 1 ) 
else 
pc . global_rank_add_point ( 1 , 1 ) 
end 
elseif bIsMonster then 
pc . global_rank_add_point ( 2 , 1 ) 
elseif bIsPlayer then 
pc . global_rank_add_point ( 3 , 1 ) 
end 
