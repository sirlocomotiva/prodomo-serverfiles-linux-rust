say_title ( "Moonlight Box Drop" ) 
say ( ) 
say_reward ( "State: " .. event_panel . get_state ( "moon_drop" ) ) 
say ( ) 
local s = select ( "Enable Event" , "Disable Event" , "Exit" ) 
