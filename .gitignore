/.scratch/ledger188/chat_enum

# Bundled third-party headers contain directories named debug/, log/, x86/, win32/ and arm/
# that the build-output rules above would otherwise hide. Re-include those directories only;
# the file-level rules above (for example .DS_Store) still apply inside them.
!/server/extern/include/**/
!/client/Extern/include/**/
