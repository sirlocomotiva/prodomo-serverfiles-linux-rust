# Agent/runtime state
/.overlord/
.omo
.codegraph

# Scratch output and nested experiment clones: local only, never committed.
# The tracked notes under .scratch/ stay in git.
/.scratch/tmp/

# Superseded planning state
/.sisyphus/

# Rust/Cargo build output
/target/

# Local server configuration; it holds the real store password. Not anchored, so a copy under
# config/ or a scratch tree is ignored too. config/prodomo.toml.example stays tracked.
prodomo.toml

