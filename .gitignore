# Agent/runtime state
/.overlord/
/.opencode/
.omo
.codegraph

# Scratch output and nested experiment clones: local only, never committed.
# Everything else under .scratch/ is tracked.
/.scratch/tmp/

# A compiled probe: only the sources and the README of .scratch/probes/ are tracked.
/.scratch/probes/**
!/.scratch/probes/**/
!/.scratch/probes/**/*.cpp
!/.scratch/probes/README.md

# The scratch commit-message drafts a session writes at the root: local only.
/COMMIT_MSG_*.txt

# Rust/Cargo build output
/target/

# The server's log folder when `prodomo` runs from the source tree (`LOG_DIR` defaults to ./log).
/log/

# Local server configuration; it holds the real store password. Not anchored, so a copy under
# config/ or a scratch tree is ignored too. config/prodomo.toml.example stays tracked.
prodomo.toml
# The store password `compose.yaml` reads.
/.env

# OS and editor metadata
.DS_Store
Thumbs.db
.idea/
.vs/
.vscode/

# Patch, backup, log and crash-dump leftovers
*.orig
*.rej
*.bak
*.swp
*.log
*.tmp
*.core
core.[0-9]*

# Python artifacts
__pycache__/
*.pyc

# No rule here names a build-output directory (debug/, log/, x86/, bin/, obj/ and the like):
# nothing is built in server/, and server/extern/include/ has tracked directories with such names.
